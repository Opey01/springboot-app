pipeline {
  agent any
  tools { maven 'Maven3' }

  options {
    timestamps()
    skipDefaultCheckout(true)
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }

  parameters {
    booleanParam(name: 'ENABLE_MONITORING', defaultValue: true, description: 'Install/upgrade Prometheus + Grafana (kube-prometheus-stack)')
  }

  environment {
    // --- AWS/ECR ---
    AWS_REGION      = 'us-east-2'
    ACCOUNT_ID      = '850924742604'
    ECR_REPO        = 'mydockerrepo'
    ECR_URL         = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"

    // --- Git/Build tagging (immutable-safe & unique) ---
    IMAGE_TAG       = ""               // set later from BUILD_NUMBER + GIT_SHA
    LATEST_TAG      = "latest"         // optional "latest" push (not overwritten if registry is immutable)

    // --- Repo/Build ---
    REPO_URL        = 'https://github.com/Opey01/springboot-app.git'
    BRANCH          = 'main'
    DOCKERFILE      = 'Dockerfilejenkins'

    // --- Trivy cache to avoid space/time churn ---
    TRIVY_CACHE_DIR = "${WORKSPACE}/.trivycache"

    // --- K8s/Helm ---
    APP_NAMESPACE   = "helm-deployment"
    APP_NAME        = "springboot"     // Helm release & k8s Deployment/Service name (we override fullname)
    CONTAINER_PORT  = "8085"

    // We'll resolve this at runtime:
    HELM_CHART_PATH = ""
    MONITORING_NS   = "prometheus"
  }

  stages {

    stage('Prep (Clean)') {
      steps {
        deleteDir()
      }
    }

    stage('Checkout') {
      steps {
        git url: "${REPO_URL}", branch: "${BRANCH}", changelog: false, poll: false
      }
    }

    stage('Compute Vars') {
      steps {
        script {
          def sha = sh(returnStdout: true, script: "git rev-parse --short=8 HEAD").trim()
          env.GIT_SHA   = sha
          env.IMAGE_TAG = "build-${env.BUILD_NUMBER}-${sha}"

          // Resolve Helm chart location robustly:
          // Prefer repo "mychart/", then "my-chart/", else fallback to $HOME/mychart
          def chartPath = ""
          if (fileExists("${WORKSPACE}/mychart/Chart.yaml")) {
            chartPath = "${WORKSPACE}/mychart"
          } else if (fileExists("${WORKSPACE}/my-chart/Chart.yaml")) {
            chartPath = "${WORKSPACE}/my-chart"
          } else {
            chartPath = "${env.HOME}/mychart"
          }
          env.HELM_CHART_PATH = chartPath

          echo "Resolved HELM_CHART_PATH: ${env.HELM_CHART_PATH}"
          echo "Using tag: ${env.IMAGE_TAG}"
        }
      }
    }

    stage('Build (Maven)') {
      steps {
        sh 'mvn -B -DskipTests clean package'
      }
    }

    stage('Archive Jar') {
      steps {
        archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
      }
    }

    stage('Docker Build & Tag') {
      steps {
        sh '''
          set -eux
          echo "Building Docker image ${ECR_URL}:${IMAGE_TAG}"
          docker build -f ${DOCKERFILE} -t ${ECR_URL}:${IMAGE_TAG} .
        '''
      }
    }

    stage('Trivy Scan') {
      steps {
        sh '''
          set +e
          mkdir -p "${TRIVY_CACHE_DIR}"
          echo "Running Trivy (vuln only, CRITICAL/HIGH)…"
          docker run --rm \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v "${TRIVY_CACHE_DIR}:/root/.cache/trivy" \
            aquasec/trivy:latest image \
            --scanners vuln \
            --severity CRITICAL,HIGH \
            --format table \
            --no-progress \
            ${ECR_URL}:${IMAGE_TAG} | tee trivy-report.txt

          # Do not fail the build automatically; you can gate on contents if desired.
          # If you want to fail when CRITICALs exist, uncomment below:
          # grep -q " CRITICAL " trivy-report.txt && { echo "CRITICAL vulns found"; exit 1; } || true

          exit 0
        '''
        archiveArtifacts artifacts: 'trivy-report.txt', fingerprint: true
      }
    }

    stage('ECR Login & Push') {
      steps {
        sh '''
          set -eux

          # Ensure repo exists
          aws ecr describe-repositories --repository-names ${ECR_REPO} --region ${AWS_REGION} >/dev/null 2>&1 || \
            aws ecr create-repository --repository-name ${ECR_REPO} --region ${AWS_REGION}

          # Login
          aws ecr get-login-password --region ${AWS_REGION} | \
            docker login --username AWS --password-stdin ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

          # Push unique build tag (never collides with immutable tags)
          docker push ${ECR_URL}:${IMAGE_TAG}

          # Optionally push :latest if your ECR policy allows mutable tags
          set +e
          docker tag ${ECR_URL}:${IMAGE_TAG} ${ECR_URL}:${LATEST_TAG}
          docker push ${ECR_URL}:${LATEST_TAG} || echo "Skipping ':latest' push (repo immutable or blocked)."
        '''
      }
    }

    stage('Helm Deploy to EKS') {
      steps {
        sh '''
          set -eux

          # Ensure namespace
          kubectl create namespace ${APP_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

          # Install/upgrade
          helm upgrade --install ${APP_NAME} ${HELM_CHART_PATH} \
            --namespace ${APP_NAMESPACE} \
            --create-namespace \
            --set image.repository=${ECR_URL} \
            --set image.tag=${IMAGE_TAG} \
            --set containerPort=${CONTAINER_PORT} \
            --set service.type=LoadBalancer \
            --set service.port=80 \
            --set autoscaling.enabled=false \
            --set ingress.enabled=false \
            --set fullnameOverride=${APP_NAME} \
            --set serviceAccount.create=true \
            --set serviceAccount.name="" \
            --atomic --timeout 10m

          # Rollout + quick status
          kubectl rollout status deploy/${APP_NAME} -n ${APP_NAMESPACE}
          kubectl get deploy,rs,pods,svc -n ${APP_NAMESPACE} -l app=${APP_NAME} || true
        '''
      }
    }

    stage('Setup Monitoring (Prometheus + Grafana)') {
      when { expression { return params.ENABLE_MONITORING } }
      steps {
        sh '''
          set -eux
          kubectl get ns ${MONITORING_NS} >/dev/null 2>&1 || kubectl create namespace ${MONITORING_NS}

          helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
          helm repo update

          helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
            -n ${MONITORING_NS} \
            --set grafana.service.type=LoadBalancer \
            --set prometheus.service.type=LoadBalancer \
            --wait --timeout 15m

          echo "Services in ${MONITORING_NS}:"
          kubectl get svc -n ${MONITORING_NS}
        '''
      }
    }
  }

  post {
    success {
      sh '''
        echo "✅ SUCCESS"
        echo -n "🌐 App URL: "
        kubectl get svc ${APP_NAME} -n ${APP_NAMESPACE} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'; echo ":80"

        if [ "${ENABLE_MONITORING}" = "true" ]; then
          echo -n "📈 Grafana URL: "
          kubectl get svc kube-prometheus-stack-grafana -n ${MONITORING_NS} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'; echo
          echo "🔑 Grafana default login: admin / prom-operator"
        fi
      '''
    }
    failure {
      echo '❌ Pipeline failed — check the logs above.'
    }
    always {
      sh '''
        docker logout ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com || true
      '''
      cleanWs()
    }
  }
}
