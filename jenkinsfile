pipeline {
  agent any
  options {
    timestamps()
    skipDefaultCheckout(true)
    buildDiscarder(logRotator(numToKeepStr: '10'))  // keep last 10 builds
  }

  environment {
    AWS_REGION       = 'us-east-2'
    ACCOUNT_ID       = '850924742604'
    ECR_REPO         = 'mydockerrepo'
    IMAGE_TAG        = "build-${env.BUILD_NUMBER}"
    REPO_URL         = 'https://github.com/Opey01/springboot-app.git'
    BRANCH           = 'main'
    DOCKERFILE       = 'Dockerfilejenkins'
    TRIVY_CACHE_DIR  = "${WORKSPACE}/.trivycache"
    ECR_URL          = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
    HELM_CHART_PATH  = "${WORKSPACE}/mychart"          // adjust to your actual chart path
    APP_NAMESPACE    = "helm-deployment"
    MONITORING_NS    = "prometheus"
  }

  stages {

    stage('Prep (Clean Workspace)') {
      steps {
        echo "🧹 Cleaning Jenkins workspace..."
        deleteDir()
      }
    }

    stage('Pre-clean Docker (Safe)') {
      steps {
        sh '''
          echo "🧽 Cleaning Docker system (builder, containers, images, volumes)..."
          docker system prune -a -f --volumes || true
        '''
      }
    }

    stage('Checkout Code') {
      steps {
        git url: "${REPO_URL}", branch: "${BRANCH}", changelog: false, poll: false
      }
    }

    stage('Build (Maven)') {
      steps {
        echo "⚙️ Building JAR package..."
        sh 'mvn -B -DskipTests clean package'
      }
    }

    stage('Archive JAR') {
      steps {
        archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
      }
    }

    stage('Docker Build & Tag') {
      steps {
        sh '''
          echo "🐳 Building Docker image..."
          docker build -f ${DOCKERFILE} -t ${ECR_URL}:${IMAGE_TAG} .
        '''
      }
    }

    stage('Trivy Security Scan') {
      steps {
        sh '''
          echo "🔍 Running Trivy scan on image..."
          mkdir -p "${TRIVY_CACHE_DIR}"
          docker run --rm \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v "${TRIVY_CACHE_DIR}:/root/.cache/trivy" \
            aquasec/trivy:latest image \
            --scanners vuln \
            --skip-java-db-update \
            --severity CRITICAL,HIGH \
            --exit-code 0 \
            --no-progress \
            ${ECR_URL}:${IMAGE_TAG} || echo "⚠️ Trivy found vulnerabilities (review manually)."
        '''
      }
    }

    stage('Push to AWS ECR') {
      steps {
        sh '''
          echo "🔐 Authenticating and pushing image to ECR..."
          aws ecr describe-repositories --repository-names ${ECR_REPO} --region ${AWS_REGION} >/dev/null 2>&1 || \
            aws ecr create-repository --repository-name ${ECR_REPO} --region ${AWS_REGION}

          aws ecr get-login-password --region ${AWS_REGION} | \
            docker login --username AWS --password-stdin ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

          docker push ${ECR_URL}:${IMAGE_TAG}
        '''
      }
    }

    stage('Helm Deploy to EKS') {
      steps {
        sh '''
          echo "☸️  Setting up kubeconfig for EKS..."
          aws eks update-kubeconfig --region ${AWS_REGION} --name demo-eks-2

          echo "🚀 Deploying SpringBoot App via Helm..."
          kubectl get ns ${APP_NAMESPACE} >/dev/null 2>&1 || kubectl create ns ${APP_NAMESPACE}

          helm upgrade --install springboot ${HELM_CHART_PATH} \
            --namespace ${APP_NAMESPACE} \
            --set image.repository=${ECR_URL%/*} \
            --set image.tag=${IMAGE_TAG} \
            --set service.type=LoadBalancer \
            --atomic --timeout 10m

          echo "✅ Checking deployment status..."
          kubectl rollout status deployment/springboot -n ${APP_NAMESPACE} || true
          kubectl get pods -n ${APP_NAMESPACE} -o wide
          kubectl get svc -n ${APP_NAMESPACE}
        '''
      }
    }

    stage('Setup Monitoring (Prometheus + Grafana)') {
      steps {
        sh '''
          echo "📊 Deploying Prometheus & Grafana..."
          kubectl get ns ${MONITORING_NS} >/dev/null 2>&1 || kubectl create ns ${MONITORING_NS}

          helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
          helm repo update

          helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
            -n ${MONITORING_NS} \
            --set grafana.service.type=LoadBalancer \
            --set prometheus.service.type=LoadBalancer \
            --wait --timeout 10m

          echo "🔎 Monitoring stack deployed successfully."
          kubectl get svc -n ${MONITORING_NS}
        '''
      }
    }
  }

  post {
    success {
      sh '''
        echo "✅ Deployment Successful!"
        echo "🌐 App URL:"
        kubectl get svc springboot -n ${APP_NAMESPACE} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'; echo
        echo "📈 Grafana URL:"
        kubectl get svc kube-prometheus-stack-grafana -n ${MONITORING_NS} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'; echo
        echo "🔑 Grafana Login: admin / prom-operator"
      '''
    }
    failure {
      echo "❌ Pipeline failed — check logs for details."
    }
    always {
      sh '''
        docker logout ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com || true
        rm -rf ${TRIVY_CACHE_DIR} || true
        cleanWs()
      '''
    }
  }
}
